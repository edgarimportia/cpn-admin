rules_version = '2';
// Firestore rules para el proyecto "cpn-demo-comercial" (demo público).
// Todo abierto — los datos se resetean cada noche vía cron.
// NO usar estas rules en producción.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
