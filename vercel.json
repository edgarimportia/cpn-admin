{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/entrar", "permanent": false },
    { "source": "/panel", "destination": "/entrar", "permanent": false },
    { "source": "/mi-cuenta", "destination": "/entrar", "permanent": false },
    { "source": "/tienda", "destination": "/", "permanent": false }
  ]
}
